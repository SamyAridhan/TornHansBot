# Copy this to `.env` for local runs, or set these as GitHub repo Secrets for Actions.
# NEVER commit real values. .env is gitignored.

# Your Torn API key — generate a LIMITED / minimal-access key at:
#   Torn -> Settings -> API Keys
# A limited key can read bars/cooldowns/travel; that's all this tool needs.
TORN_API_KEY=your_limited_torn_api_key

# Telegram bot token from @BotFather (see README step 2)
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Telegram chat id (see README step 3)
TELEGRAM_CHAT_ID=123456789

# Optional: where to store the alert-dedup state (default: state.json)
# STATE_FILE=state.json
